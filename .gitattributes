# Normalize line endings in the repository.
# Files are stored with LF in git and checked out per-platform, so a Windows
# or OneDrive checkout no longer shows every file as modified.
* text=auto eol=lf

# Keep these strictly LF (scripts and CI configs must not gain CR)
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf

# Binary assets must never be line-ending converted
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.vsix  binary
*.pdf   binary
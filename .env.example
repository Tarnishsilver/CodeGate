# ─────────────────────────────────────────────────────────────
# CodeGate — environment configuration
# Copy to `.env` and fill in what you need.
# ─────────────────────────────────────────────────────────────
#
# NOTHING HERE IS REQUIRED FOR DETECTION.
# The analyzer is fully deterministic and works with no configuration,
# no credentials, and no network access.
#
# ─────────────────────────────────────────────────────────────
# OPTIONAL: AWS Bedrock AI remediation advisor
# ─────────────────────────────────────────────────────────────
# The advisor only runs when BOTH the flag below is set AND a model
# is reachable. It explains leaks the analyzer has already proven and
# proposes fixes. It never decides whether a leak exists.
#
# Master opt-in switch (required):
CODEGATE_AI=1

# Bedrock model id. Must have model access granted in your account.
# Any model supporting the Bedrock Converse API works.
CODEGATE_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# CODEGATE_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# CODEGATE_BEDROCK_MODEL=amazon.nova-pro-v1:0

# Region (falls back to AWS_REGION / AWS_DEFAULT_REGION).
AWS_REGION=us-east-1

# Optional AWS profile for the credentials boto3 should use.
# AWS_PROFILE=default

# Standard AWS credentials also work without a profile:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
#
# Tuning:
# CODEGATE_BEDROCK_MAX_TOKENS=1200
# CODEGATE_BEDROCK_TEMPERATURE=0.2
#
# ─────────────────────────────────────────────────────────────
# OPTIONAL: GitHub token, used only by the dashboard to list repos.
# ─────────────────────────────────────────────────────────────
# GITHUB_TOKEN=